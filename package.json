{
  "name": "codebase-archaeologist",
  "private": true,
  "version": "0.1.0",
  "description": "Understand what a GitHub codebase does, why it exists, how it evolved, and what changing it could affect.",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @archaeologist/web dev",
    "build": "pnpm --filter @archaeologist/web build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @archaeologist/db migrate",
    "db:studio": "pnpm --filter @archaeologist/db studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
