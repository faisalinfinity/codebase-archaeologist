# -----------------------------------------------------------------------------
# Codebase Archaeologist — environment template
# Copy to apps/web/.env.local for the Next.js app.
# Never commit real secrets. Never expose server-only values to the browser.
# -----------------------------------------------------------------------------

# --- Browser (safe to prefix with NEXT_PUBLIC_) ---
# Canonical public origin for redirects and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL (anon key is a public client key, NOT the service role).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Server (Next.js route handlers / packages/api) ---
# Postgres connection string. Local: postgresql://archaeologist:archaeologist@localhost:5432/archaeologist
DATABASE_URL=postgresql://archaeologist:archaeologist@localhost:5432/archaeologist

# Optional direct (non-pooled) URL for migrations against hosted Postgres.
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase service role — server only. Never send to the browser.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# --- Worker / future (Milestone 2+) — unused in Milestone 1 ---
# REDIS_URL=redis://localhost:6379
# GITHUB_API_TOKEN=
# DEMO_AI_PROVIDER=openai
# DEMO_AI_MODEL=gpt-4o-mini
# DEMO_AI_API_KEY=
# ENCRYPTION_KEY=

# --- Object storage (optional, unused in Milestone 1) ---
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
