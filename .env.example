# -----------------------------------------------------------------------------
# Codebase Archaeologist — environment template
# Copy to apps/web/.env.local for the Next.js app.
# Worker: export DATABASE_URL, REDIS_URL, and optional GITHUB_API_TOKEN.
# Never commit real secrets. Never expose server-only values to the browser.
# -----------------------------------------------------------------------------

# --- Browser (safe to prefix with NEXT_PUBLIC_) ---
# Canonical public origin for redirects and links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL (anon key is a public client key, NOT the service role).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Server (Next.js route handlers / packages/api) ---
# Postgres connection string. Local: postgresql://archaeologist:archaeologist@localhost:5432/archaeologist
DATABASE_URL=postgresql://archaeologist:archaeologist@localhost:5432/archaeologist
# Small per-instance pool for Vercel; Supabase transaction pooling is supported.
# DATABASE_POOL_MAX=3

# Optional direct (non-pooled) URL for migrations against hosted Postgres.
# DIRECT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase service role — server only. Never send to the browser.
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Redis for BullMQ (API enqueue + worker). Unset = create PENDING jobs without running them.
REDIS_URL=redis://localhost:6379

# Optional GitHub token for higher metadata rate limits (server/worker only).
# GITHUB_API_TOKEN=

# Optional semantic search. Set on BOTH web and worker; keyword search needs no AI key.
# Never expose this as NEXT_PUBLIC_*.
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# MAX_EMBED_CHUNKS=2000
# EMBED_TIMEOUT_MS=600000

# Optional repository chat. Server-side only; no chat key is sent to the browser.
# DEMO_AI_PROVIDER=openai
# DEMO_AI_MODEL=gpt-4.1-mini
# DEMO_AI_API_KEY=
# MAX_CHAT_REQUESTS_PER_HOUR=20
# MAX_CHAT_OUTPUT_TOKENS=1200
# Separate combined reasoning/output cap for zero-price OpenRouter reasoning models.
# MAX_FREE_REASONING_TOKENS=8192

# Ingestion limits (server/worker)
# MAX_REPOSITORY_SIZE_MB=500
# MAX_FILES=20000
# MAX_FILE_SIZE_MB=1
# CLONE_TIMEOUT_MS=120000
# SCAN_TIMEOUT_MS=120000
# MAX_HISTORY_COMMITS=50
# HISTORY_TIMEOUT_MS=120000
# WORKER_CONCURRENCY=1
# WORKER_RUN_ONCE=1 # Exit after draining the queue; used by manual GitHub Actions.

# Personal provider keys: generate once with `openssl rand -hex 32`, retain across deploys.
# ENCRYPTION_KEY=
# Administrator-approved exact HTTPS origins for custom compatible providers.
# CUSTOM_AI_ALLOWED_ORIGINS=https://api.example.com
# MAX_REPOSITORY_REQUESTS_PER_HOUR=10
# MAX_INDEX_REQUESTS_PER_HOUR=10
# MAX_PROVIDER_SETTINGS_PER_HOUR=30
# Full mode clones all history on the indexed branch; processing remains bounded.
# HISTORY_MODE=recent
# In full mode MAX_HISTORY_COMMITS defaults to 10000; configurable cap 100000.

# --- Object storage (optional, unused) ---
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
